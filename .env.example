# Copy to .env and fill in — used by docker-compose for local development only.

# --- Postgres ---
POSTGRES_USER=checkout
POSTGRES_PASSWORD=checkout
POSTGRES_DB=checkout

# --- MinIO (local S3-compatible store, stands in for the product-images bucket) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Payment gateway sandbox (see test brief for your sandbox keys) ---
PAYMENT_GATEWAY_API_URL=https://api-sandbox.your-gateway.example/v1
PAYMENT_GATEWAY_PUBLIC_KEY=pub_stagtest_xxxxxxxxxxxxxxxxxxxxxxxxx
PAYMENT_GATEWAY_PRIVATE_KEY=prv_stagtest_xxxxxxxxxxxxxxxxxxxxxxxxx
PAYMENT_GATEWAY_EVENTS_KEY=stagtest_events_xxxxxxxxxxxxxxxxxxxxxxxxx
PAYMENT_GATEWAY_INTEGRITY_KEY=stagtest_integrity_xxxxxxxxxxxxxxxxxxxxxxxxx

# --- CORS ---
# Comma-separated list of origins allowed to call the backend API.
CORS_ORIGIN=https://localhost:5173
